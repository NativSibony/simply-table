{
  "name": "simply-table",
  "version": "0.1.2",
  "description": "A production-ready table library",
  "type": "module",
  "main": "./dist/simply-table.umd.cjs",
  "module": "./dist/simply-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/simply-table.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/simply-table.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 0",
    "dev:docs": "npm run update:pack && cd docs && npm run reset && npm run dev",
    "update:pack": "rm -rf dist && rm -rf simply-table-*.tgz && npm run build && npm pack",
    "reset": "rm -rf node_modules && rm -rf dist && rm -rf .vite && npm install"
  },
  "keywords": [
    "data-grid",
    "grid",
    "table",
    "data-table",
    "react",
    "component",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NativSibony/simply-table.git"
  },
  "bugs": {
    "url": "https://github.com/NativSibony/simply-table/issues"
  },
  "homepage": "https://github.com/NativSibony/simply-table#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17"
  }
}
